      "required_course_codes": ["CS 412", "CS 302"],
      "allowed_course_codes": ["CS 412", "CS 412R", "CS 302", "CS 302R", "CS 308", "CS 308L"],
      "any_terms": ["conflict", "credit"],
      "required_actions": ["get_current_schedule"],
      "forbidden_actions": ["build_timetable", "set_plan"],
      "forbidden_patterns": ["graduation requirements|remaining degree requirements|you still need"],
      "kind": "general-ui-check-schedule"
    }
  ]
